f=\"https://www.google.com/maps/place/Lacivert+Ormanc%C4%B1l%C4%B1k+M%C3%BChendislik/@40.7145355,29.9389795,19z\" target=\"_blank\" rel=\"noopener\" aria-label=\"Google Maps\"><i class=\"fa-solid fa-map-location-dot\"></i></a>\r\n    </div>\r\n  </div>\r\n  <!-- NAVBAR -->\r\n  <header class=\"nav\">\r\n    <div class=\"container nav__inner\">\r\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Lacivert Ormancılık\">\r\n        <img src=\"img/logo-yeni.png\" alt=\"Lacivert Ormancılık Logo\" style=\"height:55px;vertical-align:middle;\" decoding=\"async\">\r\n      </a>\r\n      <nav aria-label=\"Ana Menü\">\r\n        <ul id=\"navLinks\" class=\"nav__links\">\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"#kurumsal\" class=\"nav__link\">Kurumsal <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"hakkimizda.html\">Hakkımızda</a></li>\r\n              <li><a href=\"sss.html\">Sıkça Sorulan Sorular</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"#services\" class=\"nav__link\">Hizmetlerimiz <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"izinirtifak.html\">İzin ve İrtifak Danışmanlışı</a></li>\r\n              <li><a href=\"surdurulebilirlik.html\">Sürdürülebilirlik ve Sertifikasyon</a></li>\r\n              <li><a href=\"muhendislik.html\">Mühendislik ve Teknolojik Çözümler</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"#ormancilik\" class=\"nav__link\">Ormancılık <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"kanunveyonetmelikler.html\">Kanun ve Yönetmelikler</a></li>\r\n              <li><a href=\"ormanizinleri.html\">Orman İzinleri</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"madde16.html\" class=\"nav__link\">Projeler <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"madde16.html\">Madde 16</a></li>\r\n              <li><a href=\"madde17.html\">Madde 17</a></li>\r\n              <li><a href=\"diger.html\">Diğer</a></li>\r\n            </ul>\r\n          </li>\r\n          <li><a href=\"galeri.html\" class=\"nav__link\">Galeri</a></li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"iletisim.html\" class=\"nav__link\">İletişim <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"iletisim.html\">Bize Ulaşın</a></li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </nav>\r\n      <button id=\"burger\" class=\"nav__burger\" aria-label=\"Mobil Menü\">\r\n        <span></span><span></span><span></span>\r\n      </button>\r\n    </div>\r\n  </header>\r\n\r\n  <main>\r\n    <!-- SERVICE HERO -->\r\n    <section class=\"service-hero\">\r\n      <div class=\"container\">\r\n        <div class=\"service-hero__content\" data-fade>\r\n          <div class=\"service-hero__badge\">\r\n            <i class=\"fas fa-file-contract\"></i>\r\n            <span>Uzman Danışmanlık</span>\r\n          </div>\r\n          <h1 class=\"service-hero__title\">İzin ve İrtifak Danışmanlışı</h1>\r\n          <p class=\"service-hero__subtitle\">\r\n            Orman arazilerinde projelerinizin hukuki süreçlerini başından sonuna kadar yönetiyor, \r\n            karmaşık mevzuatları sizin adınıza çözüme kavuşturuyoruz.\r\n          </p>\r\n          <div class=\"service-hero__features\">\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-shield-check\"></i>\r\n              <span>%100 Yasal Güvence</span>\r\n            </div>\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-clock\"></i>\r\n              <span>Hızlı Süreç Yönetimi</span>\r\n            </div>\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-handshake\"></i>\r\n              <span>Kurumsal Temsil</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CONTENT SECTION 1 -->\r\n    <section class=\"content-section\">\r\n      <div class=\"container\">\r\n        <div class=\"content-grid\">\r\n          <div class=\"content-text\" data-fade>\r\n            <h2>Projelerinizin Önündeki Hukuki Engelleri Aşıyoruz</h2>\r\n            <p>\r\n              Orman mülkiyetindeki arazilerde gerçekleştirilen her proje, karmaşık yasal süreçlerden geçmek zorundadır. \r\n              Maden işletmeciliğinden enerji santrallerine, altyapı projelerinden turizm tesislerine kadar geniş bir \r\n              yelpazede uzman danışmanlık hizmeti sunuyoruz.\r\n            </p>\r\n            <div class=\"content-features\">\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-search\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Ön İzin Süreçleri</h4>\r\n                  <p>Projenizin fizibilite aşamasında gerekli ön izinlerin alınması ve risk analizlerinin yapılması</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-stamp\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Kesin İzin Başvuruları</h4>\r\n                  <p>Detaylı proje dosyalarının hazırlanması ve kesin izin süreçlerinin yönetimi</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-key\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>İrtifak Hakkı Tescili</h4>\r\n                  <p>Uzun vadeli projeler için irtifak haklarının tesis edilmesi ve tapuya tescil işlemleri</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"content-image\" data-fade>\r\n            <img src=\"img/proje-yolu.jpg\" alt=\"Orman arazisinde proje yolu\" decoding=\"async\" loading=\"lazy\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- STATS SECTION -->\r\n    <section class=\"stats-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section__header\" data-fade>\r\n          <h2 class=\"section__title\" style=\"color: white;\">Başarı Rakamlarımız</h2>\r\n          <p class=\"section__subtitle\" style=\"color: rgba(255,255,255,0.9);\">\r\n            Yılların deneyimi ve uzman kadromuzla elde ettişimiz sonuçlar\r\n          </p>\r\n        </div>\r\n        <div class=\"stats-grid\" data-fade>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">150+</span>\r\n            <span class=\"stat-card__label\">Tamamlanan Proje</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">%98</span>\r\n            <span class=\"stat-card__label\">Başarı Oranı</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">5</span>\r\n            <span class=\"stat-card__label\">Yıllık Deneyim</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">24/7</span>\r\n            <span class=\"stat-card__label\">Destek Hizmeti</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CONTENT SECTION 2 -->\r\n    <section class=\"content-section content-section--alt\">\r\n      <div class=\"container\">\r\n        <div class=\"content-grid\">\r\n          <div class=\"content-image\" data-fade>\r\n            <img src=\"img/drone-haritalama.jpg\" alt=\"Drone ile haritalama\" decoding=\"async\" loading=\"lazy\">\r\n          </div>\r\n          <div class=\"content-text\" data-fade>\r\n            <h2>Hangi Sektörlerde Hizmet Veriyoruz?</h2>\r\n            <p>\r\n              Farklı sektörlerden gelen projelerin kendine özgü gereksinimleri vardır. \r\n              Her sektörün mevzuat özelliklerini bilen uzman kadromuzla, projenizin \r\n              türüne uygun en etkin çözümleri sunuyoruz.\r\n            </p>\r\n            <div class=\"content-features\">\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-mountain\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Maden Sektörü</h4>\r\n                  <p>Maden arama ve işletme izinleri, ÇED süreçleri, orman vasıf değişiklişi</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-bolt\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Enerji Projeleri</h4>\r\n                  <p>RES, HES, GES projeleri için izin süreçleri ve irtifak hakkı tesisi</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-road\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Altyapı Tesisleri</h4>\r\n                  <p>Yol, boru hattı, nakil hattı projeleri için gerekli izin ve irtifak işlemleri</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- PROCESS SECTION -->\r\n    <section class=\"process-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section__header\" data-fade>\r\n          <div class=\"section__badge\">\r\n            <i class=\"fas fa-cogs\"></i>\r\n            <span>Çalışma Sürecimiz</span>\r\n          </div>\r\n          <h2 class=\"section__title\">4 Adımda İzin Süreci Yönetimi</h2>\r\n          <p class=\"section__subtitle\">\r\n            Sistematik yaklaşımımızla projenizin her aşamasını kontrol altında tutuyoruz\r\n          </p>\r\n        </div>\r\n        <div class=\"process-grid\">\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">1</div>\r\n            <h4>Ön Analiz & Değerlendirme</h4>\r\n            <p>Projenizin mevzuata uygunluŞunu analiz eder, risk değerlendirmesi yapar ve yol haritası çizeriz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">2</div>\r\n            <h4>Başvuru Dosyası Hazırlışı</h4>\r\n            <p>Gerekli tüm teknik çizim, rapor ve belgeleri eksiksiz olarak hazırlar, başvuru dosyanızı oluştururuz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">3</div>\r\n            <h4>Süreç Takibi ve Temsil</h4>\r\n            <p>Başvuruyu yapar, ilgili kurumlarda projenizi sizin adınıza takip eder ve temsil ederiz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">4</div>\r\n            <h4>İzin Sonuçlandırma</h4>\r\n            <p>İznin onaylanmasını sağlar, irtifak hakkı gibi hakların tapuya tescil işlemlerini tamamlarız.</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CTA BANNER -->\r\n    <section class=\"cta-banner\">\r\n      <div class=\"container\">\r\n        <div class=\"cta-banner__content\" data-fade>\r\n          <h2>Projenizin Potansiyelini Birlikte Değerlendirelim</h2>\r\n          <p>\r\n            Zaman ve para kaybetmeden, projenizin önündeki hukuki engelleri nasıl aşabileceşinizi \r\n            öşrenmek için uzman ekibimizle iletişime geçin.\r\n          </p>\r\n          <a href=\"iletisim.html\" class=\"btn btn--large\">\r\n            <i class=\"fas fa-phone\"></i>\r\n            <span>Ücretsiz Danışmanlık Alın</span>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <!-- Footer -->\r\n  <footer class=\"footer\">\r\n    <div class=\"footer__background\"></div>\r\n    <div class=\"container footer__grid\">\r\n      <div class=\"footer__brand\">\r\n        <img src=\"img/logo-yeni.png\" alt=\"Lacivert Ormancılık Logo\" class=\"footer__logo\" decoding=\"async\" loading=\"lazy\">\r\n        <div class=\"footer__info\">\r\n          <strong>Lacivert Ormancılık</strong><br>\r\n          Selahattin Eyyübi Caddesi, Serdar Mahallesi, No:36, İç Kapı No: 11, 41 OFFİCE<br>Başiskele/KOCAELİ<br>\r\n          <a href=\"mailto:info@lacivertormancilik.com\">info@lacivertormancilik.com</a><br>\r\n          <span class=\"footer__phone\">Bizi arayın: (+90) 530 909 41 08</span>\r\n        </div>\r\n        <div class=\"footer__social\">\r\n          <a href=\"https://www.instagram.com/lacivertormancilik?igsh=MWw0b2pmcm9ib2ZmMw==\" target=\"_blank\" aria-label=\"Instagram\"><i class=\"fab fa-instagram\"></i></a>\r\n          <a href=\"https://www.linkedin.com/company/laci%CC%87vert-ormancilik-m%C3%BChendi%CC%87sli%CC%87k-san-ti%CC%87c-ltd-%C5%9Fti%CC%87/?viewAsMember=true\" target=\"_blank\" aria-label=\"LinkedIn\"><i class=\"fab fa-linkedin-in\"></i></a>\r\n          <a href=\"https://www.google.com/maps/place/Lacivert+Ormanc%C4%B1l%C4%B1k+M%C3%BChendislik