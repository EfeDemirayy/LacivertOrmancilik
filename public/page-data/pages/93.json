_dropdown\">\r\n            <a href=\"#ormancilik\" class=\"nav__link\">Ormancılık <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"kanunveyonetmelikler.html\">Kanun ve Yönetmelikler</a></li>\r\n              <li><a href=\"ormanizinleri.html\">Orman İzinleri</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"madde16.html\" class=\"nav__link\">Projeler <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"madde16.html\">Madde 16</a></li>\r\n              <li><a href=\"madde17.html\">Madde 17</a></li>\r\n              <li><a href=\"diger.html\">Diğer</a></li>\r\n            </ul>\r\n          </li>\r\n          <li><a href=\"galeri.html\" class=\"nav__link\">Galeri</a></li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"iletisim.html\" class=\"nav__link\">İletişim <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"iletisim.html\">Bize Ulaşın</a></li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </nav>\r\n      <button id=\"burger\" class=\"nav__burger\" aria-label=\"Mobil Menü\">\r\n        <span></span><span></span><span></span>\r\n      </button>\r\n    </div>\r\n  </header>\r\n\r\n  <main>\r\n    <!-- SERVICE HERO -->\r\n    <section class=\"service-hero\">\r\n      <div class=\"container\">\r\n        <div class=\"service-hero__content\" data-fade>\r\n          <div class=\"service-hero__badge\">\r\n            <i class=\"fas fa-certificate\"></i>\r\n            <span>Sürdürülebilir Gelecek</span>\r\n          </div>\r\n          <h1 class=\"service-hero__title\">Sürdürülebilirlik ve Sertifikasyon</h1>\r\n          <p class=\"service-hero__subtitle\">\r\n            Çevresel sorumluluŞunuzu küresel standartlarla belgeleyin. FSC, PEFC ve ISO 14001 \r\n            sertifikasyonları ile markanızın güvenilirlişini artırın.\r\n          </p>\r\n          <div class=\"service-hero__features\">\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-globe\"></i>\r\n              <span>Küresel Standartlar</span>\r\n            </div>\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-leaf\"></i>\r\n              <span>Çevre Dostu</span>\r\n            </div>\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-award\"></i>\r\n              <span>Uluslararası Tanınırlık</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CONTENT SECTION 1 -->\r\n    <section class=\"content-section\">\r\n      <div class=\"container\">\r\n        <div class=\"content-grid\">\r\n          <div class=\"content-text\" data-fade>\r\n            <h2>Geleceşe SorumluluŞumuz: Sürdürülebilirlik</h2>\r\n            <p>\r\n              Ekonomik faaliyetlerin ekolojik dengeyle uyum içinde yürütülmesi gerektişine inanıyoruz. \r\n              Sürdürülebilirlik ve uluslararası sertifikasyonlar, şirketlerin hem gezegenimize karşı \r\n              sorumluluklarını yerine getirmesini hem de küresel pazarlarda rekabet gücü kazanmasını sağlar.\r\n            </p>\r\n            <div class=\"content-features\">\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-earth-europe\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Küresel Pazar Erişimi</h4>\r\n                  <p>Uluslararası sertifikalarla dünya pazarlarında güvenilir partner olun</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-handshake\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Artan Kurumsal İtibar</h4>\r\n                  <p>Sürdürülebilirlik taahhüdünüzle marka değerinizi yükseltin</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-recycle\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Çevresel Sorumluluk</h4>\r\n                  <p>Gelecek nesillere daha yaşanabilir bir dünya bırakın</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"content-image\" data-fade>\r\n            <img src=\"img/surdurulebilir-orman.jpg\" alt=\"Sürdürülebilir yönetilen orman\" decoding=\"async\" loading=\"lazy\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- STATS SECTION -->\r\n    <section class=\"stats-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section__header\" data-fade>\r\n          <h2 class=\"section__title\" style=\"color: white;\">Sertifikasyonun Getirdikleri</h2>\r\n          <p class=\"section__subtitle\" style=\"color: rgba(255,255,255,0.9);\">\r\n            Sürdürülebilirlik sertifikasyonlarının işletmenize sağladışı avantajlar\r\n          </p>\r\n        </div>\r\n        <div class=\"stats-grid\" data-fade>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">50%</span>\r\n            <span class=\"stat-card__label\">Pazar Payında Artış Potansiyeli</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">100%</span>\r\n            <span class=\"stat-card__label\">Yasal Mevzuata Uyum</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">75%</span>\r\n            <span class=\"stat-card__label\">Marka İtibarında Yükselme</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">20%</span>\r\n            <span class=\"stat-card__label\">Operasyonel Verimlilik</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CONTENT SECTION 2 -->\r\n    <section class=\"content-section content-section--alt\">\r\n      <div class=\"container\">\r\n        <div class=\"content-grid\">\r\n          <div class=\"content-image\" data-fade>\r\n            <img src=\"img/katmadegerliuretim.jpg\" alt=\"Katma değerli üretim\" decoding=\"async\" loading=\"lazy\">\r\n          </div>\r\n          <div class=\"content-text\" data-fade>\r\n            <h2>Sertifikasyon Hizmetlerimiz</h2>\r\n            <p>\r\n              Her sertifikasyon türünün kendine özgü gereksinimleri vardır. Uzman kadromuzla, \r\n              işletmenizin ihtiyaçlarına en uygun sertifikasyon süreçlerini yönetiyor, \r\n              uluslararası standartlara uyumunuzu sağlıyoruz.\r\n            </p>\r\n            <div class=\"content-features\">\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fab fa-foursquare\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>FSC® Danışmanlışı</h4>\r\n                  <p>Sorumlu Orman Yönetimi (FM) ve Koruma Zinciri (CoC) sertifikasyon süreçleri</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-certificate\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>PEFC®\" Danışmanlışı</h4>\r\n                  <p>Orman Yönetimi ve Koruma Zinciri sertifikasyonu ile sürdürülebilir kaynak kullanımı</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-leaf\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>ISO 14001 Çevre Yönetimi</h4>\r\n                  <p>Çevresel performansınızı sürekli iyileştirmek için yönetim sistemi kurulumu</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- PROCESS SECTION -->\r\n    <section class=\"process-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section__header\" data-fade>\r\n          <div class=\"section__badge\">\r\n            <i class=\"fas fa-cogs\"></i>\r\n            <span>Sertifikasyon Süreci</span>\r\n          </div>\r\n          <h2 class=\"section__title\">5 Adımda Sertifikasyon</h2>\r\n          <p class=\"section__subtitle\">\r\n            Sistematik yaklaşımımızla sertifikasyon sürecinizi başarıyla tamamlıyoruz\r\n          </p>\r\n        </div>\r\n        <div class=\"process-grid\">\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">1</div>\r\n            <h4>Ön Değerlendirme</h4>\r\n            <p>İşletmenizin mevcut durumunu analiz eder, sertifikasyon gereksinimlerini belirleriz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">2</div>\r\n            <h4>Sistem Kurulumu</h4>\r\n            <p>Gerekli yönetim sistemlerini kurar, prosedürleri oluşturur ve personel eşitimi veririz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">3</div>\r\n            <h4>İç Denetim</h4>\r\n            <p>Sistemin etkinlişini test eder, eksiklikleri tespit eder ve iyileştirme önerileri sunarız.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">4</div>\r\n            <h4>Sertifikasyon Denetimi</h4>\r\n            <p>Akredite kuruluş denetiminde işletmenizi temsil eder, süreç boyunca destek sağlarız.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">5</div>\r\n            <h4>Sürekli İyileştirme</h4>\r\n            <p>Sertifika alındıktan sonra da sistemin sürdürülmesi için sürekli destek veriyoruz.</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CTA BANNER -->\r\n    <section class=\"cta-banner\">\r\n      <div class=\"container\">\r\n        <div class=\"cta-banner__content\" data-fade>\r\n          <h2>Sürdürülebilir Geleceşe Adım Atın</h2>\r\n          <p>\r\n            İşletmenizin çevresel performansını artırın, küresel pazarlarda rekabet avantajı kazanın. \r\n            Sertifikasyon sürecinizi uzman ekibimizle başlatın.\r\n          </p>\r\n          <a href=\"iletisim.html\" class=\"btn btn--large\">\r\n            <i class=\"fas fa-envelope\"></i>\r\n            <span>Bilgi Almak İstiyorum</span>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <footer class=\"footer\">\r\n    <div class=\"footer__background\"></div>\r\n    <div class=\"container footer__grid\">\r\n      <div class=\"footer__brand\">\r\n        <img src=\"img/logo-yeni.png\" alt=\"Lacivert Ormancılık Logo\" class=\"footer__logo\" decoding=\"async\" loading=\"lazy\">\r\n        <div class=\"footer__info\">\r\n          <strong>Lacivert Ormancılık</strong><br>\r\n          Selahattin Eyyübi Caddesi, Serdar Mahallesi, No:36, İç Kapı No: 11, 41 OFFİCE<br>Başiskele/KOCAELİ<br>\r\n          <a href=\"mailto:info@lacivertormancilik.com\">info@lacivertormancilik.com</a><br>\r\n          <span c