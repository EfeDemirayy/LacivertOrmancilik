a-label=\"LinkedIn\"><i class=\"fab fa-linkedin-in\"></i></a>\r\n      <a href=\"https://www.google.com/maps/place/Lacivert+Ormanc%C4%B1l%C4%B1k+M%C3%BChendislik/@40.7145355,29.9389795,19z\" target=\"_blank\" rel=\"noopener\" aria-label=\"Google Maps\"><i class=\"fa-solid fa-map-location-dot\"></i></a>\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"preloader\" class=\"preloader\">\r\n    <div class=\"preloader__spinner\"><i class=\"fas fa-spinner fa-pulse\"></i></div>\r\n  </div>\r\n\r\n  <div id=\"progress\" class=\"progress\"><div class=\"progress__bar\"></div></div>\r\n\r\n  <header class=\"nav\">\r\n    <div class=\"container nav__inner\">\r\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Lacivert Ormancılık\">\r\n        <img src=\"img/logo-yeni.png\" alt=\"Lacivert Ormancılık Logo\" style=\"height:55px;vertical-align:middle;\" decoding=\"async\">\r\n      </a>\r\n      <nav aria-label=\"Ana Menü\">\r\n        <ul id=\"navLinks\" class=\"nav__links\">\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"#kurumsal\" class=\"nav__link\">Kurumsal <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"hakkimizda.html\">Hakkımızda</a></li>\r\n              <li><a href=\"sss.html\">Sıkça Sorulan Sorular</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"#services\" class=\"nav__link\">Hizmetlerimiz <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"izinirtifak.html\">İzin ve İrtifak Danışmanlışı</a></li>\r\n              <li><a href=\"surdurulebilirlik.html\">Sürdürülebilirlik ve Sertifikasyon</a></li>\r\n              <li><a href=\"muhendislik.html\">Mühendislik ve Teknolojik Çözümler</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"#ormancilik\" class=\"nav__link\">Ormancılık <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"kanunveyonetmelikler.html\">Kanun ve Yönetmelikler</a></li>\r\n              <li><a href=\"ormanizinleri.html\">Orman İzinleri</a></li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"madde16.html\" class=\"nav__link\">Projeler <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"madde16.html\">Madde 16</a></li>\r\n              <li><a href=\"madde17.html\">Madde 17</a></li>\r\n              <li><a href=\"diger.html\">Diğer</a></li>\r\n            </ul>\r\n          </li>\r\n          <li><a href=\"galeri.html\" class=\"nav__link\">Galeri</a></li>\r\n          <li class=\"nav__dropdown\">\r\n            <a href=\"iletisim.html\" class=\"nav__link\">İletişim <i class=\"fa-solid fa-chevron-down\"></i></a>\r\n            <ul class=\"dropdown\">\r\n              <li><a href=\"iletisim.html\">Bize Ulaşın</a></li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </nav>\r\n      <button id=\"burger\" class=\"nav__burger\" aria-label=\"Mobil Menü\">\r\n        <span></span><span></span><span></span>\r\n      </button>\r\n    </div>\r\n  </header>\r\n\r\n  <main>\r\n    <!-- SERVICE HERO -->\r\n    <section class=\"service-hero\">\r\n      <div class=\"container\">\r\n        <div class=\"service-hero__content\" data-fade>\r\n          <div class=\"service-hero__badge\">\r\n            <i class=\"fas fa-drone\"></i>\r\n            <span>İleri Teknoloji</span>\r\n          </div>\r\n          <h1 class=\"service-hero__title\">Mühendislik ve Teknolojik Çözümler</h1>\r\n          <p class=\"service-hero__subtitle\">\r\n            Geleneksel mühendislik tecrübemizi en son teknolojiyle birleştiriyoruz. \r\n            Drone, LiDAR ve CBS ile projelerinizde maksimum verimlilik sağlıyoruz.\r\n          </p>\r\n          <div class=\"service-hero__features\">\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-satellite-dish\"></i>\r\n              <span>Hassas Veri Toplama</span>\r\n            </div>\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-chart-line\"></i>\r\n              <span>Etkin Risk Analizi</span>\r\n            </div>\r\n            <div class=\"service-hero__feature\">\r\n              <i class=\"fas fa-gears\"></i>\r\n              <span>Optimize Süreç</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CONTENT SECTION 1 -->\r\n    <section class=\"content-section\">\r\n      <div class=\"container\">\r\n        <div class=\"content-grid\">\r\n          <div class=\"content-text\" data-fade>\r\n            <h2>Teknolojiyle Projelerinize Değer Katıyoruz</h2>\r\n            <p>\r\n              Geleneksel mühendislik tecrübemizi en son teknolojiyle birleştiriyoruz. \r\n              Drone, LiDAR ve Coşrafi Bilgi Sistemleri (CBS) gibi araçlar kullanarak \r\n              projelerinizde maksimum verimlilik, hassasiyet ve güvenlik sağlıyoruz.\r\n            </p>\r\n            <div class=\"content-features\">\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-satellite-dish\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Hassas Veri Toplama</h4>\r\n                  <p>Yüksek çözünürlüklü verilerle sahanın tüm dinamiklerini analiz ediyoruz</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-chart-line\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Etkin Risk Analizi</h4>\r\n                  <p>Potansiyel riskleri önceden tespit ederek projenizi güvence altına alıyoruz</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-gears\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Optimize Edilmiş Süreç</h4>\r\n                  <p>Zaman ve maliyetten tasarruf sağlayan akıllı çözümler geliştiriyoruz</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"content-image\" data-fade>\r\n            <img src=\"img/drone-haritalama.jpg\" alt=\"Drone ile orman haritalama\" decoding=\"async\" loading=\"lazy\">\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- STATS SECTION -->\r\n    <section class=\"stats-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section__header\" data-fade>\r\n          <h2 class=\"section__title\" style=\"color: white;\">Teknolojinin Getirdikleri</h2>\r\n          <p class=\"section__subtitle\" style=\"color: rgba(255,255,255,0.9);\">\r\n            İleri teknoloji kullanımının projelerinize sağladışı avantajlar\r\n          </p>\r\n        </div>\r\n        <div class=\"stats-grid\" data-fade>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">40%</span>\r\n            <span class=\"stat-card__label\">Proje Süresinde Kısalma</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">99.8%</span>\r\n            <span class=\"stat-card__label\">Veri Hassasiyeti</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">30%</span>\r\n            <span class=\"stat-card__label\">Maliyet Avantajı</span>\r\n          </div>\r\n          <div class=\"stat-card\">\r\n            <span class=\"stat-card__number\">100%</span>\r\n            <span class=\"stat-card__label\">Güvenli Operasyon</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CONTENT SECTION 2 -->\r\n    <section class=\"content-section content-section--alt\">\r\n      <div class=\"container\">\r\n        <div class=\"content-grid\">\r\n          <div class=\"content-image\" data-fade>\r\n            <img src=\"img/dijitallesme-opt.jpg\" alt=\"Dijitalleşme teknolojileri\" decoding=\"async\" loading=\"lazy\">\r\n          </div>\r\n          <div class=\"content-text\" data-fade>\r\n            <h2>Teknolojik Çözümlerimiz</h2>\r\n            <p>\r\n              Her teknolojinin kendine özgü avantajları vardır. Projenizin ihtiyaçlarına \r\n              göre en uygun teknolojik çözümleri seçiyor, entegre sistemler kuruyoruz.\r\n            </p>\r\n            <div class=\"content-features\">\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-plane-up\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>Drone & Fotogrametri</h4>\r\n                  <p>Yüksek çözünürlüklü hava fotoşrafları ile 3D modeller ve ortofotolar üretiyoruz</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-cube\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>LiDAR Haritalama</h4>\r\n                  <p>Lazer tarama teknolojisiyle bitki örtüsü altındaki gerçek topografyayı ortaya çıkarıyoruz</p>\r\n                </div>\r\n              </div>\r\n              <div class=\"content-feature\">\r\n                <div class=\"content-feature__icon\">\r\n                  <i class=\"fas fa-map-location-dot\"></i>\r\n                </div>\r\n                <div class=\"content-feature__text\">\r\n                  <h4>CBS Analizi</h4>\r\n                  <p>Tüm mekansal verilerinizi analiz eder, projenize özel coşrafi veri tabanları oluştururuz</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- PROCESS SECTION -->\r\n    <section class=\"process-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section__header\" data-fade>\r\n          <div class=\"section__badge\">\r\n            <i class=\"fas fa-cogs\"></i>\r\n            <span>Teknolojik Süreç</span>\r\n          </div>\r\n          <h2 class=\"section__title\">4 Adımda Teknolojik Çözüm</h2>\r\n          <p class=\"section__subtitle\">\r\n            Sistematik yaklaşımımızla teknolojik ihtiyaçlarınızı karşılıyoruz\r\n          </p>\r\n        </div>\r\n        <div class=\"process-grid\">\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">1</div>\r\n            <h4>Analiz ve Planlama</h4>\r\n            <p>Projelerinize başlamadan önce, yüksek çözünürlüklü verilerle sahanın tüm dinamiklerini analiz ederiz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">2</div>\r\n            <h4>Veri Toplama</h4>\r\n            <p>Drone, LiDAR ve diğer teknolojilerle sahadan hassas veriler toplar, dijital arşiv oluştururuz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">3</div>\r\n            <h4>Analiz ve Modelleme</h4>\r\n            <p>Toplanan verileri analiz eder, 3D modeller ve haritalar oluşturarak projenizi görselleştiririz.</p>\r\n          </div>\r\n          <div class=\"process-step\" data-fade>\r\n            <div class=\"process-step__number\">4</div>\r\n            <h4>Raporlama ve Takip</h4>\r\n            <p>Detaylı raporlar hazırlar, projenin ilerleyişini teknolojik araçlarla sürekli takip ederiz.</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- CTA BANNER -->\r\n    <section class=\"cta-banner\">\r\n      <div class=\"container\">\r\n        <div class=\"cta-banner__content\" data-fade>\r\n          <h2>Teknolojinin Gücünü Projelerinizde Kullanın</h2>\r\n          <p>\r\n            İleri teknoloji çözümlerimizle projelerinizin verimlilişini artırın, \r\n            rekabet avantajı kazanın. Uzman ekibimizle teknolojik dönüşümünüzü başlatın.\r\n          </p>\r\n          <a href=\"iletisim.html\" class=\"btn btn--large\">\r\n            <i class=\"fas fa-envelope\"></i>\r\n            <span>Teknolojik Çözümler Hakkında Bilgi Al</span>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <footer class=\"footer\">\r\n    <div class=\"footer__background\"></div>\r\n    <div class=\"container footer__grid\">\r\n      <div class=\"footer__brand\">\r\n        <img src=\"img/logo-yeni.png\" alt=\"Lacivert Ormancılık Logo\" class=\"footer__logo\" decoding=\"async\" loading=\"lazy\">\r\n        <div class=\"footer__info\">\r\n          <strong>Lacivert Ormancılık</strong><br>\r\n          Selahattin Eyyübi Caddesi, Serdar Mahallesi, No:36, İç Kapı No: 11, 41 OFFİCE<br>Başiskele/KOCAELİ<br>\r\n          <a href=\"mailto:info@lacivertormancilik.com\">info@lacivertormancilik.com</a><br>\r\n          <span class=\"footer__phone\">Bizi arayın: (+90) 530 909 41 08</span>\r\n        </div>\r\n        <div class=\"footer__social\">\r\n          <a href=\"https://www.instagram.com/lacivertormancilik?igsh=MWw0b2pmcm9ib2ZmMw==\" target=\"_blank\" aria-label=\"Instagram\"><i class=\"fab fa-instagram\"></i></a>\r\n          <a href=\"https://www.linkedin.com/company/laci%CC%87vert-ormancilik-m%C3%BChendi%CC%87sli%CC%87k-san-ti%CC%87c-ltd-%C5%9Fti%